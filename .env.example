# ============================================================
# Шаблон переменных окружения для системы мониторинга
# Скопируйте этот файл в .env и заполните все значения:
#   cp .env.example .env
# Файл .env находится в .gitignore и НЕ попадает в репозиторий.
# ============================================================

# ---------- Сетевые настройки ----------
# IP-адрес основного хоста (ВМ 1) — доступен снаружи через проброс портов
MAIN_HOST_IP=192.168.100.10
# IP-адрес подхоста (ВМ 2) — находится за двойным NAT
AGENT_HOST_IP=192.168.200.20

# ---------- Роль узла ----------
# main  — основной сервер мониторинга (Zabbix Server, Splunk, Rsyslog-server)
# agent — подхост (Apache/Nginx, Zabbix Agent 2, SNMPd, Rsyslog-client)
NODE_ROLE=main

# ---------- Настройки Zabbix ----------
# Пароль базы данных Zabbix
ZABBIX_DB_PASSWORD=ChangeMe_ZabbixDb!
# Пароль пользователя Admin в веб-интерфейсе Zabbix
ZABBIX_ADMIN_PASSWORD=ChangeMe_ZabbixAdmin!

# ---------- Настройки PostgreSQL ----------
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=ChangeMe_Postgres!
POSTGRES_DB=zabbix

# ---------- Настройки SNMPv3 (USM с аутентификацией и шифрованием) ----------
# Пользователь SNMPv3
SNMP_USER=monitor
# Пароль аутентификации (SHA), минимум 8 символов
SNMP_AUTH_PASS=ChangeMe_SnmpAuth!
# Пароль шифрования (AES), минимум 8 символов
SNMP_PRIV_PASS=ChangeMe_SnmpPriv!

# ---------- Настройки Splunk Enterprise ----------
# Пароль пользователя admin веб-интерфейса Splunk (минимум 8 символов)
SPLUNK_PASSWORD=ChangeMe_Splunk!

# ---------- Настройки TLS для Syslog ----------
# Порт приёма логов по TLS (RFC 5425 / syslog over TLS)
SYSLOG_TLS_PORT=6514
